<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the first-run setup and later model/pack downloads use it; answering never does (gate 6 checks this). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The header's ONLINE / OFFLINE pill. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings → Haptic feedback (a normal permission: granted at install, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- AnswerService: "BOAR is answering…" while an answer is written, so the phone doesn't close BOAR mid-answer
         when the user switches apps (Xiaomi did, Oct 19). Normal permissions: granted at install. Without the
         notification permission (Android 13+) the service still runs; only its notification is hidden. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.Boar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".app.AnswerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Finishes an answer the on-device model is writing while the user is in another app; stops when the answer ends." />
        </service>
        <!-- Engine bench and the eval:device runner, started from adb (am start -n …/team.sopa.boar.bench.BenchActivity).
             DUMP: adb's shell holds it and other apps can't, so only adb (USB or wireless debugging) can start a run. -->
        <activity
            android:name=".bench.BenchActivity"
            android:permission="android.permission.DUMP"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true" />
    </application>
</manifest>
