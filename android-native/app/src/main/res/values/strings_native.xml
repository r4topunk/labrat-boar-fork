    <string name="native_about_airGappedBody" formatted="false">BoarLite is an offline-first mobile AI system exploring adaptive model routing, local retrieval, and resource-aware inference. It runs local LLM inference with llama.cpp, built into the app, and local hybrid retrieval (SQLite FTS5 + on-device embeddings) with zero cloud dependencies.</string>
    <string name="native_about_siteTitle" formatted="false">Official website</string>
    <string name="native_about_siteBody" formatted="false">News and updates are posted on our official website. Don\'t fall for scams: check the address before you download anything that says it is BoarLite.</string>
    <string name="native_about_verify" formatted="false">Don\'t trust, verify.</string>
    <string name="native_about_copied" formatted="false">Copied</string>
    <string name="native_about_holdToCopy" formatted="false">Press and hold an address to copy it.</string>
